@model DenemeDetayViewModel

@{
    ViewData["Title"] = Model.Deneme.Ad;
    var testler = Model.SinavTuru.Testler.OrderBy(t => t.Sira).ToList();
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2 class="h5 mb-1">@Model.Deneme.Ad</h2>
        <div class="text-body-secondary small">
            @Model.Deneme.SinavTuruAdi · @Model.Deneme.Tarih.ToString("dd.MM.yyyy") · @Model.Deneme.KatilimciSayisi katılımcı
            @(string.IsNullOrWhiteSpace(Model.Deneme.YayinAdi) ? "" : $"· {Model.Deneme.YayinAdi}")
        </div>
    </div>
    <a asp-action="Duzenle" asp-route-id="@Model.Deneme.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Düzenle</a>
</div>

<div class="rp-kart mb-3">
    <h2 class="h6 mb-3">Sonuç Girişi</h2>
    <form asp-action="SonucGirisi" method="get" class="row g-2 align-items-end">
        <input type="hidden" name="denemeId" value="@Model.Deneme.Id" />
        <div class="col-md-4">
            <label class="form-label">Sınıf</label>
            <select name="sinifId" class="form-select" asp-items="@(new SelectList(Model.SinifSecenekleri, "Id", "Ad"))">
                <option value="">Sınıf seçin</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Sonuç Gir / Düzenle</button>
        </div>
    </form>
</div>

<div class="rp-kart">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h6 mb-0">Sonuçlar</h2>
        @if (Model.Sonuclar.Count > 0)
        {
            <a asp-action="SonuclariCsvDisaAktar" asp-route-id="@Model.Deneme.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download"></i> CSV İndir</a>
        }
    </div>
    @if (Model.Sonuclar.Count == 0)
    {
        <partial name="_BosDurum" model="@(new BosDurumViewModel { Ikon = "bi-clipboard-data", Mesaj = "Henüz sonuç girilmemiş." })" />
    }
    else
    {
        <div class="rp-tablo-sarici">
            <table class="table">
                <thead>
                    <tr>
                        <th>Öğrenci</th>
                        @foreach (var test in testler)
                        {
                            <th>@test.DersAdi</th>
                        }
                        <th>Toplam Net</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sonuc in Model.Sonuclar.OrderBy(s => s.OgrenciAdSoyad))
                    {
                        <tr>
                            <td>@sonuc.OgrenciAdSoyad</td>
                            @foreach (var test in testler)
                            {
                                var detay = sonuc.Detaylar.FirstOrDefault(d => d.SinavTuruTestId == test.Id);
                                <td>@(detay is null ? "-" : detay.Net.ToString("0.##"))</td>
                            }
                            <td class="fw-semibold">@sonuc.ToplamNet.ToString("0.##")</td>
                            <td>
                                @if (sonuc.KatilmadiMi)
                                {
                                    <span class="rp-rozet rp-rozet-notr">Katılmadı</span>
                                }
                                else
                                {
                                    <span class="rp-rozet rp-rozet-basari">Katıldı</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="SonucSil" asp-route-id="@sonuc.Id" asp-route-denemeId="@Model.Deneme.Id" method="post" class="d-inline" data-onay="Bu öğrencinin sonucunu silmek istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
