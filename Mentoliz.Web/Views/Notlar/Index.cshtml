@model NotListeViewModel

@{
    ViewData["Title"] = "Notlarım";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Ekle" class="btn btn-outline-primary"><i class="bi bi-plus-lg"></i> Not Ekle</a>
</div>

@if (Model.Notlar.Count == 0)
{
    <div class="rp-kart">
        <partial name="_BosDurum" model="@(new BosDurumViewModel { Ikon = "bi-sticky", Mesaj = "Henüz kayıtlı not yok." })" />
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var not in Model.Notlar)
        {
            <div class="col-md-4">
                <div class="rp-kart h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h2 class="h6 mb-0">@not.Baslik</h2>
                        <div class="d-flex gap-1">
                            <a asp-action="Duzenle" asp-route-id="@not.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Sil" asp-route-id="@not.Id" method="post" class="d-inline" data-onay="Bu notu silmek istediğinize emin misiniz?">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                    <p class="small flex-grow-1" style="white-space: pre-wrap;">@not.Icerik</p>
                    <div class="text-body-secondary small mt-2">Güncelleme: @not.GuncellemeTarihi.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
            </div>
        }
    </div>
}
