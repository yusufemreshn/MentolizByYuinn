@model NotFormViewModel

<form method="post" class="d-flex flex-column gap-4">
    <input type="hidden" asp-for="Not.Id" />

    <div class="rp-kart">
        <h2 class="h6 mb-3">Not Bilgileri</h2>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">Başlık</label>
                <input asp-for="Not.Baslik" class="form-control" required />
            </div>
            <div class="col-12">
                <label class="form-label">İçerik</label>
                <textarea asp-for="Not.Icerik" class="form-control" rows="8" required></textarea>
            </div>
        </div>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</form>
