    <p class="mb-2">Mentoliz aşağıdaki açık kaynak kütüphaneleri kullanır, her biri kendi lisansına tabidir:</p>
    <div class="rp-tablo-sarici">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Kütüphane</th>
                    <th>Sürüm</th>
                    <th>Lisans</th>
                    <th>Bağlantı</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bildirim in UcuncuTarafBildirimleri.Tumu)
                {
                    <tr>
                        <td>@bildirim.Kutuphane</td>
                        <td>@bildirim.Surum</td>
                        <td>@bildirim.Lisans</td>
                        <td><a href="@bildirim.Baglanti" target="_blank" rel="noopener">@bildirim.Baglanti</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
