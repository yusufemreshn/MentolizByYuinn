@model HedefFormViewModel

<form method="post" class="d-flex flex-column gap-4">
    <input type="hidden" asp-for="Hedef.Id" />
    <input type="hidden" asp-for="Hedef.OgrenciId" />

    <div class="rp-kart">
        <h2 class="h6 mb-3">@Model.OgrenciAdSoyad İçin Hedef</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Hedef Üniversite</label>
                <input asp-for="Hedef.HedefUniversite" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Hedef Bölüm</label>
                <input asp-for="Hedef.HedefBolum" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Puan Türü</label>
                <select asp-for="Hedef.PuanTuru" class="form-select">
                    @foreach (var deger in Enum.GetValues<PuanTuru>())
                    {
                        <option value="@deger">@deger.GosterimAdi()</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Hedef Sıralama</label>
                <input asp-for="Hedef.HedefSiralama" type="number" min="1" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Hedef Toplam Net</label>
                <input asp-for="Hedef.HedefToplamNet" type="number" step="0.01" min="0" class="form-control" />
            </div>
        </div>
    </div>

    <div class="rp-kart">
        <h2 class="h6 mb-3">Ders Bazlı Hedef Net</h2>
        <div class="text-body-secondary small mb-3">Sadece hedeflediğiniz derslere net girin, diğerlerini boş bırakabilirsiniz.</div>
        <div class="row g-3">
            @for (var i = 0; i < Model.DersNetSatirlari.Count; i++)
            {
                <div class="col-md-3">
                    <label class="form-label">@Model.DersNetSatirlari[i].DersAdi</label>
                    <input type="hidden" asp-for="DersNetSatirlari[i].Id" />
                    <input type="hidden" asp-for="DersNetSatirlari[i].DersId" />
                    <input type="hidden" asp-for="DersNetSatirlari[i].DersAdi" />
                    <input asp-for="DersNetSatirlari[i].HedefNet" type="number" step="0.01" min="0" class="form-control" />
                </div>
            }
        </div>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" asp-route-ogrenciId="@Model.Hedef.OgrenciId" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</form>
