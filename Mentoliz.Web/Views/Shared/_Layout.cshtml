@{
    // üst menüde, alt sekme çubuğunda ve diğer panelinde hangi öğenin aktif göründüğünü belirlemek için şu anki controller adını alıyoruz
    var aktifController = ViewContext.RouteData.Values["controller"]?.ToString();
    // aktif tema ayarlar sayfasından kaydedilen değer, filtre bunu her sayfada ViewData'ya koyuyor
    var aktifTema = ViewData["AktifTema"] as string ?? TemaSecenekleri.Varsayilan;
    // gece modu açık mı, o da aynı filtre üzerinden her sayfada geliyor
    var koyuMu = ViewData["KoyuMu"] as bool? ?? false;
    // üst çubuktaki her controller'ın Index'i ana liste sayfası, geri kalan her action (detay, ekle, düzenle, rapor, sonuç girişi vb.) iç sayfa sayılıyor
    var aktifAction = ViewContext.RouteData.Values["action"]?.ToString();
    var icSayfaMi = !string.Equals(aktifAction, "Index", StringComparison.OrdinalIgnoreCase);
    // birincil dörtlünün dışında kalan sayfalar, hem sağdaki "diğer" panelinde hem gizli komut paleti listesinde aynı diziden besleniyor
    var ikincilMenu = new (string Controller, string Action, string Ikon, string Etiket)[]
    {
        ("Siniflar", "Index", "bi-diagram-3", "Sınıflar"),
        ("Devamsizlik", "Index", "bi-calendar-x", "Devamsızlık"),
        ("Odevler", "Index", "bi-journal-text", "Ödevler"),
        ("Denemeler", "Index", "bi-clipboard-data", "Denemeler"),
        ("Gorusmeler", "Index", "bi-chat-dots", "Görüşmeler"),
        ("Hedefler", "Index", "bi-bullseye", "Hedefler"),
        ("CalismaProgramlari", "Index", "bi-calendar-week", "Çalışma Programı"),
        ("Konular", "Index", "bi-book", "Konu Takip"),
        ("Gorevler", "Index", "bi-check2-square", "Görevler"),
        ("Notlar", "Index", "bi-sticky", "Notlarım"),
        ("Ayarlar", "Index", "bi-gear", "Ayarlar"),
    };
    // aktif sayfa bu on sayfadan biriyse "diğer" düğmesi de aktif görünsün diye
    var ikincilAktifMi = ikincilMenu.Any(oge => oge.Controller == aktifController);
}
<!DOCTYPE html>
<html lang="tr" data-theme="@aktifTema" data-mod="@(koyuMu ? "koyu" : "acik")" data-bs-theme="@(koyuMu ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mentoliz</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/temalar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="rp-govde">
        <header class="rp-ustcubuk">
            <a class="rp-marka" asp-controller="Home" asp-action="Index"><i class="bi bi-mortarboard-fill"></i> Mentoliz</a>
            <nav class="rp-ustmenu" aria-label="Ana gezinme">
                @* her linkin sonundaki boş span sadece aktif olduğunda css ile görünüyor, sayfa değişince bu çizgi eski konumdan yeni konuma doğru kayarak taşınıyor *@
                <a class="rp-nav-link @(aktifController == "Home" ? "active" : "")" aria-current="@(aktifController == "Home" ? "page" : null)" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Ana Sayfa<span class="rp-aktif-cizgi"></span></a>
                <a class="rp-nav-link @(aktifController == "Bugun" ? "active" : "")" aria-current="@(aktifController == "Bugun" ? "page" : null)" asp-controller="Bugun" asp-action="Index"><i class="bi bi-calendar-check"></i> Bugün<span class="rp-aktif-cizgi"></span></a>
                <a class="rp-nav-link @(aktifController == "Ogrenciler" ? "active" : "")" aria-current="@(aktifController == "Ogrenciler" ? "page" : null)" asp-controller="Ogrenciler" asp-action="Index"><i class="bi bi-people"></i> Öğrenciler<span class="rp-aktif-cizgi"></span></a>
                <a class="rp-nav-link @(aktifController == "Takvim" ? "active" : "")" aria-current="@(aktifController == "Takvim" ? "page" : null)" asp-controller="Takvim" asp-action="Index"><i class="bi bi-calendar3"></i> Takvim<span class="rp-aktif-cizgi"></span></a>
                <button type="button" class="rp-ustmenu-diger @(ikincilAktifMi ? "active" : "")" data-bs-toggle="offcanvas" data-bs-target="#rp-diger-sayfalar" aria-controls="rp-diger-sayfalar">
                    <i class="bi bi-grid-3x3-gap"></i> Diğer
                </button>
            </nav>
        </header>
        <div class="rp-icerik-alani">
            <header class="rp-topbar">
                <div class="d-flex align-items-center gap-2">
                    @if (icSayfaMi)
                    {
                        <button type="button" class="rp-geri-dugmesi" onclick="history.back()" aria-label="Geri dön" title="Geri dön"><i class="bi bi-arrow-left"></i></button>
                    }
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="rp-geri-dugmesi rp-komut-ac" id="komut-paleti-ac" aria-label="Öğrenci ara veya sayfaya git" title="Ara (Ctrl+K)"><i class="bi bi-search"></i></button>
                    @* geçici: arkadaşlara test amaçlı gönderirken örnek veri yükleyip silebilmek için, teslimden önce kaldırılacak *@
                    <form method="post" asp-controller="Ayarlar" asp-action="DemoVeriYukle" data-onay="Mevcut öğrenci, sınıf, deneme, ödev ve not verilerinin yerine örnek test verisi yüklenecek. Devam edilsin mi?">
                        <input type="hidden" name="donusUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button type="submit" class="rp-tehlike-dugmesi" aria-label="Test verisi yükle" title="Test verisi yükle">
                            <i class="bi bi-magic"></i>
                        </button>
                    </form>
                    <form method="post" asp-controller="Ayarlar" asp-action="DemoVeriSil" data-onay="Örnek test verisi (öğrenciler, sınıflar, denemeler, ödevler, notlar vb.) tamamen silinecek. Devam edilsin mi?">
                        <input type="hidden" name="donusUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button type="submit" class="rp-tehlike-dugmesi" aria-label="Test verisini sil" title="Test verisini sil">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </form>
                    <form method="post" asp-controller="Ayarlar" asp-action="KoyuModDegistir">
                        <input type="hidden" name="donusUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button type="submit" class="rp-koyu-mod-dugmesi" aria-label="@(koyuMu ? "Gündüz moduna geç" : "Gece moduna geç")" title="@(koyuMu ? "Gündüz moduna geç" : "Gece moduna geç")">
                            <i class="bi @(koyuMu ? "bi-sun" : "bi-moon-stars")"></i>
                        </button>
                    </form>
                </div>
            </header>
            <main class="rp-sayfa-icerigi">
                <partial name="_Bildirim" />
                @RenderBody()
            </main>
        </div>

        @* dar ekranda üst menüdeki linkler gizleniyor, gezinme buradan yapılıyor, tek elle erişilebilsin diye ekranın altında sabit duruyor *@
        <nav class="rp-altsekme" aria-label="Mobil gezinme">
            <a class="rp-nav-link @(aktifController == "Bugun" ? "active" : "")" aria-current="@(aktifController == "Bugun" ? "page" : null)" asp-controller="Bugun" asp-action="Index"><i class="bi bi-calendar-check"></i><span>Bugün</span></a>
            <a class="rp-nav-link @(aktifController == "Ogrenciler" ? "active" : "")" aria-current="@(aktifController == "Ogrenciler" ? "page" : null)" asp-controller="Ogrenciler" asp-action="Index"><i class="bi bi-people"></i><span>Öğrenciler</span></a>
            <button type="button" class="rp-altsekme-orta rp-komut-ac" id="komut-paleti-ac-mobil" aria-label="Öğrenci ara veya sayfaya git"><i class="bi bi-search"></i></button>
            <a class="rp-nav-link @(aktifController == "Takvim" ? "active" : "")" aria-current="@(aktifController == "Takvim" ? "page" : null)" asp-controller="Takvim" asp-action="Index"><i class="bi bi-calendar3"></i><span>Takvim</span></a>
            <button type="button" class="@(ikincilAktifMi ? "active" : "")" data-bs-toggle="offcanvas" data-bs-target="#rp-diger-sayfalar" aria-controls="rp-diger-sayfalar"><i class="bi bi-grid-3x3-gap"></i><span>Diğer</span></button>
        </nav>
    </div>

    @* birincil dörtlünün dışındaki sayfalar burada toplanıyor, hem üst çubuktaki hem alt sekmedeki "diğer" düğmesi bunu açıyor *@
    <div class="offcanvas offcanvas-end" tabindex="-1" id="rp-diger-sayfalar" aria-labelledby="rp-diger-baslik">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title h6 mb-0" id="rp-diger-baslik">Diğer Sayfalar</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
        </div>
        <div class="offcanvas-body pt-0">
            <ul class="rp-diger-liste list-unstyled mb-0">
                @foreach (var oge in ikincilMenu)
                {
                    <li><a class="@(aktifController == oge.Controller ? "active" : "")" aria-current="@(aktifController == oge.Controller ? "page" : null)" asp-controller="@oge.Controller" asp-action="@oge.Action"><i class="bi @oge.Ikon"></i> @oge.Etiket</a></li>
                }
            </ul>
        </div>
    </div>

    @* komut paleti, ctrl+k veya arama düğmeleriyle açılıyor, öğrenci arama ve sayfalar arasında hızlı geçiş için *@
    <div id="komut-paleti-perde" class="rp-komut-paleti-perde d-none">
        <div class="rp-komut-paleti" role="dialog" aria-modal="true" aria-label="Ara">
            <div class="rp-komut-paleti-arama">
                <i class="bi bi-search"></i>
                <input type="text" id="komut-paleti-girdi" placeholder="Öğrenci ara veya sayfaya git..." autocomplete="off"
                       role="combobox" aria-expanded="false" aria-controls="komut-paleti-sonuclar" aria-autocomplete="list" aria-label="Öğrenci ara veya sayfaya git" />
                <kbd>Esc</kbd>
            </div>
            <ul id="komut-paleti-sonuclar" class="rp-komut-paleti-sonuclar" role="listbox" aria-label="Arama sonuçları"></ul>
        </div>
    </div>

    @* komut paletinin sayfa kısayolları listesi buradan besleniyor, ekranda görünmüyor, sadece veri kaynağı *@
    <ul class="rp-komut-sayfa-listesi d-none">
        <li><a href="@Url.Action("Index", "Home")"><i class="bi bi-house-door"></i>Ana Sayfa</a></li>
        <li><a href="@Url.Action("Index", "Bugun")"><i class="bi bi-calendar-check"></i>Bugün</a></li>
        <li><a href="@Url.Action("Index", "Ogrenciler")"><i class="bi bi-people"></i>Öğrenciler</a></li>
        <li><a href="@Url.Action("Index", "Takvim")"><i class="bi bi-calendar3"></i>Takvim</a></li>
        @foreach (var oge in ikincilMenu)
        {
            <li><a href="@Url.Action(oge.Action, oge.Controller)"><i class="bi @oge.Ikon"></i>@oge.Etiket</a></li>
        }
    </ul>

    @* bildirimler burada, sağ üstte sabit konumda birikiyor *@
    <div id="rp-toast-alani" class="rp-toast-alani" aria-live="polite"></div>

    @* bütün sil/geri yükle gibi işlemler tarayıcının çirkin confirm() kutusu yerine bu tek paylaşılan modalı kullanıyor *@
    <div class="modal fade" id="rp-onay-modali" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body rp-onay-govde">
                    <i class="bi bi-exclamation-triangle-fill rp-onay-ikon"></i>
                    <p class="rp-onay-mesaj mb-0"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" class="btn btn-danger" id="rp-onay-onayla">Evet, Devam Et</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/komut-paleti.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
