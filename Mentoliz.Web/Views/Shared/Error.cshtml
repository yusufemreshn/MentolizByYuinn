@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="rp-kart rp-hata-ekrani">
    <i class="bi bi-exclamation-octagon-fill"></i>
    <h2>Bir şeyler ters gitti</h2>
    <p>İşleminiz sırasında beklenmeyen bir hata oluştu. Sayfayı yenileyip tekrar deneyebilir ya da ana sayfaya dönebilirsiniz.</p>

    @if (Model.ShowRequestId)
    {
        <p class="rp-hata-istek-no">İstek numarası: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house-door"></i> Ana Sayfaya Dön</a>
</div>
