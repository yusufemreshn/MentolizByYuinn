@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mentoliz</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/temalar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rapor.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="rp-rapor-govde">
    <div class="rp-rapor-arac-cubugu no-print">
        <a asp-controller="Ogrenciler" asp-action="Detay" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Öğrenciye Dön</a>
        <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Yazdır</button>
    </div>
    <div class="rp-rapor-sayfa">
        @RenderBody()
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
