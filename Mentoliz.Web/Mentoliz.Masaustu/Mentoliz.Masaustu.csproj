<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mentoliz</AssemblyName>
    <ApplicationIcon>..\mentoliz.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <!-- webapplication ve kestrel türlerine erişmek için lazım, sunucuyu burada başlatıyoruz -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mentoliz.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- sunucu ayarları web projesinin dizininde, kabuk çalışırken kendi çıktı klasöründen de bulabilsin diye buraya kopyalıyoruz -->
    <Content Include="..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- css, js ve font dosyaları da aynı sebeple buraya kopyalanıyor, klasik statik dosya sunumu fiziksel wwwroot klasörü istiyor -->
    <Content Include="..\wwwroot\**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
